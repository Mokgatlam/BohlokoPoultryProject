PORT=5000
# MySQL Database Configuration (local development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bohloko_farm
# PostgreSQL Database Configuration (Render production - auto-set by Render)
DATABASE_URL=postgres://user:password@host:5432/database
# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Application URL
BASE_URL=http://localhost:5000
NODE_ENV=development
# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# PayFast Payment Gateway
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_MODE=sandbox
PAYFAST_RETURN_URL=http://localhost:5000/pages/public/payment-success.html
PAYFAST_CANCEL_URL=http://localhost:5000/pages/public/payment-cancel.html
PAYFAST_NOTIFY_URL=http://localhost:5000/api/payfast/notify